# Copy to .env and replace every secret:
#   cp .env.example .env
#   openssl rand -base64 48   # for JWT_SECRET
#   openssl rand -hex 24      # for POSTGRES_PASSWORD / REDIS_PASSWORD

APP_ENV=production
HTTP_PORT=8080
APP_URL=http://localhost:8080

POSTGRES_DB=authguard
POSTGRES_USER=authguard
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# HMAC-SHA256 signing key, at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SESSION_MAX_LIFETIME=720h

# Must be true when served over HTTPS (required for any non-localhost APP_URL).
COOKIE_SECURE=false

# Defaults to the bundled Mailpit catcher (UI on http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AuthGuard <no-reply@authguard.local>
